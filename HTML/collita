<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <title>Afegir Collita</title>
<style>
body { font-family: Arial, sans-serif; background:#f5fff5; padding:20px; }
form { background:white; padding:20px; border-radius:8px; max-width:500px; margin:auto;
       box-shadow:0 2px 6px rgba(0,0,0,0.1); }
label { font-weight:bold; margin-top:10px; display:block; }
input, select, button { width:100%; padding:8px; margin-top:5px; border-radius:4px; border:1px solid #ccc; }
button { margin-top:15px; background:#2f7d2f; color:white; padding:10px; border:none;
         border-radius:5px; cursor:pointer; width:100%; }
button:hover { background:#3d9b3d; }
</style>
</head>
<body>

    <h2>Registrar Collita</h2>

    <form action=".../php/guardar_collita.php" method="post">
        <label>Data Inici *</label>
        <input type="datetime-local" name="data_inici" required>

        <label>Data Fi</label>
        <input type="datetime-local" name="data_fi">

        <label>ID Plantació *</label>
        <input type="number" name="plantacio_id" required>

        <label>Quantitat Total</label>
        <input type="number" step="0.01" name="quantitat_total">

        <label>Unitat *</label>
        <select name="unitat" required>
            <option value="kg">Kg</option>
            <option value="caixa">Caixa</option>
            <option value="bin">Bin</option>
        </select>

        <label>Condicions Ambientals</label>
        <textarea name="condicions_ambientals"></textarea>

        <label>ID Estat</label>
        <input type="number" name="id_estat">

        <label>Maduresa</label>
        <input type="text" name="maduresa">

        <label>Incidències</label>
        <textarea name="incidencies"></textarea>

        <label>ID Operari</label>
        <input type="number" name="id_operari">

        <label>ID Maquinària</label>
        <input type="number" name="id_maquinaria">

        <button type="submit">Guardar</button>

    </form>

</body>
</html>
